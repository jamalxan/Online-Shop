# ─── Django Core ──────────────────────────────────────────
# Yangi kalit: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=your-secret-key-here
# Production'da albatta False
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (bo'sh bo'lsa SQLite ishlatiladi) ───────────
# DB_NAME=appleshop
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=yourpassword

# ─── Redis (OTP va rate-limit; production'da majburiy) ────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Email (Gmail SMTP; production'da majburiy) ───────────
# DEBUG=True va bu qiymatlar bo'sh bo'lsa, kodlar konsolga chiqadi
EMAIL_HOST_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
# Gmail'dan boshqa provayder uchun (sukut: smtp.gmail.com:587, STARTTLS)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# ─── CORS / CSRF ──────────────────────────────────────────
# Frontend manzili (vergul bilan bir nechta)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Django admin (/admin/) HTTPS domeni uchun, masalan: https://api.example.uz
CSRF_TRUSTED_ORIGINS=

# ─── Sessiya cookie'si (refresh token httpOnly cookie'da) ──
# Frontend va API bitta asosiy domenda bo'lsa (shop.uz + api.shop.uz) hech narsa o'zgartirmang.
# Secure: sukut bo'yicha DEBUG=False da yoqiladi (HTTPS shart)
# AUTH_COOKIE_SECURE=True
# Lax (sukut) | Strict | None. None faqat frontend va API butunlay boshqa domenlarda bo'lsa.
# AUTH_COOKIE_SAMESITE=Lax
# Odatda kerak emas (cookie API domeniga bog'lanadi)
# AUTH_COOKIE_DOMAIN=

# ─── Xavfsizlik ───────────────────────────────────────────
# Admin hisoblar faqat parol + email kod bilan kiradi
ADMIN_OTP_REQUIRED=True
# Nginx/proxy ortida bo'lsa 1 (rate-limit haqiqiy IP bo'yicha ishlashi uchun)
NUM_PROXIES=0
# Admin sessiyasining mutlaq muddati (soat). Shundan keyin qayta kirish (parol + kod) kerak
ADMIN_SESSION_HOURS=12
# Django'ning o'z /admin/ sahifasi faqat parol bilan himoyalangan (email kod yo'q).
# Production'da sukut bo'yicha o'chiq; kerak bo'lsa True qiling (kirish urinishlari IP bo'yicha cheklangan).
# DJANGO_ADMIN_ENABLED=False
# Production (DEBUG=False) uchun: HTTPS'ga yo'naltirish va HSTS
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ─── Bildirishnomalar (ixtiyoriy) ─────────────────────────
# Yangi buyurtma haqida xabar oladigan xodimlar (vergul bilan)
ORDER_NOTIFY_EMAILS=
# Yangi buyurtmani Telegram'ga ham yuborish: bot tokeni va chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── To'lov ───────────────────────────────────────────────
# Onlayn to'lov usullari (Apple Pay, Google Pay, Click, Payme, Xazna) haqiqiy to'lov tizimiga
# ULANMAGAN: True bo'lsa ular demo rejimda ishlaydi (pul yechilmaydi, to'lov "demo" deb yoziladi).
# Haqiqiy savdoda False qiling — saytda faqat "qabul qilganda to'lash" qoladi.
DEMO_PAYMENTS=True

# ─── Fayllar ──────────────────────────────────────────────
# To'lov cheklari saqlanadigan yopiq papka (sukut: loyiha ichida private_media/).
# Bu papkani nginx orqali OCHMANG — cheklar faqat API orqali, token bilan beriladi.
# PRIVATE_MEDIA_ROOT=/var/lib/apex/private_media

# ─── Firebase (telefon orqali kirish, ixtiyoriy) ──────────
FIREBASE_CREDENTIALS=serviceAccountKey.json
